{
  "name": "@tally/web",
  "description": "Count all the things!",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "remix": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module' remix",
    "build": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module' remix vite:build",
    "dev": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module' remix vite:dev",
    "test": "vitest",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module' remix-serve ./build/server/index.js",
    "migrations:generate": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module'drizzle-kit generate",
    "migrate": "NODE_OPTIONS='--experimental-strip-types --experimental-require-module'drizzle-kit migrate",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.5",
    "@remix-run/node": "^2.15.2",
    "@remix-run/react": "^2.15.2",
    "@remix-run/serve": "^2.15.2",
    "@tally/contract": "workspace:*",
    "@tally/typedconfig": "workspace:*",
    "drizzle-cuid2": "^1.0.5",
    "drizzle-orm": "^0.33.0",
    "isbot": "^4.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.15.2",
    "@remix-run/fs-routes": "^2.15.2",
    "@remix-run/route-config": "^2.15.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "autoprefixer": "^10.4.19",
    "drizzle-kit": "^0.24.2",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.1.6",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
