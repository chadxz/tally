{
  "name": "@tally/web",
  "description": "Count all the things!",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "deploy": "netlify deploy --build",
    "lint": "eslint .",
    "start": "react-router-serve build/server/index.js",
    "migrations:generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "prepare": "react-router typegen",
    "typecheck": "react-router typegen && tsc",
    "update-deps": "npm-check -u",
    "clean": "rm -rf node_modules build .netlify .react-router"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@react-router/node": "^7.1.5",
    "@react-router/serve": "^7.1.5",
    "@tally/contract": "workspace:*",
    "camelcase-keys": "^9.1.3",
    "drizzle-cuid2": "^2.0.0",
    "drizzle-orm": "^0.39.2",
    "isbot": "^5.1.22",
    "react": "19.0.0",
    "react-daisyui": "^5.0.5",
    "react-dom": "19.0.0",
    "react-router": "^7.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@netlify/vite-plugin-react-router": "^1.0.0",
    "@react-router/dev": "^7.1.5",
    "@react-router/fs-routes": "^7.1.5",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/eslint-plugin": "^1.1.27",
    "autoprefixer": "^10.4.19",
    "daisyui": "^4.12.23",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import-x": "^4.6.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "netlify-cli": "^18.0.4",
    "npm-check": "^6.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
