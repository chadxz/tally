{
  "name": "tally",
  "version": "1.0.0",
  "description": "Keep a tally of whatever you want.",
  "author": "Chad McElligott <chad@chadxz.dev>",
  "license": "MIT",
  "scripts": {
    "update-deps": "npm-check -u",
    "update": "nx run-many --target=update-deps --parallel=false",
    "clean": "nx run-many --target=clean --all"
  },
  "devDependencies": {
    "npm-check": "^6.0.1",
    "nx": "^20.3.2",
    "prettier": "^3.4.2"
  },
  "packageManager": "pnpm@9.15.4"
}
